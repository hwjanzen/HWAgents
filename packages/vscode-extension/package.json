{
  "name": "hwagents-vscode-extension",
  "displayName": "HW Agents",
  "version": "0.0.1",
  "publisher": "hwjanzen",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:hwagents.hello",
    "onCommand:hwagents.configureProject",
    "onCommand:hwagents.previewOfficeManifest",
    "onCommand:hwagents.checkCopilotStudio",
    "onCommand:hwagents.copyCpsManifestUrl",
    "onCommand:hwagents.showCpsInstructions",
    "onCommand:hwagents.syncLooka",
    "onCommand:hwagents.runSkillTests",
    "onCommand:hwagents.createSkillWizard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "HW Agents",
      "properties": {
        "hwagents.githubOwner": {
          "type": "string",
          "default": "hwjanzen",
          "description": "GitHub owner or organization name."
        },
        "hwagents.githubRepo": {
          "type": "string",
          "default": "HWAgents",
          "description": "GitHub repository name."
        },
        "hwagents.githubBranch": {
          "type": "string",
          "default": "main",
          "description": "Branch used to resolve skill and agent files."
        },
        "hwagents.officeManifestPath": {
          "type": "string",
          "default": "skills/manifest/office-manifest.json",
          "description": "Path to the Office skill manifest inside the repository."
        }
      }
    },
    "commands": [
      {
        "command": "hwagents.hello",
        "title": "HW Agents: Hello"
      },
      {
        "command": "hwagents.configureProject",
        "title": "HW Agents: Configure Project"
      },
      {
        "command": "hwagents.previewOfficeManifest",
        "title": "HW Agents: Preview Office Manifest"
      },
      {
        "command": "hwagents.checkCopilotStudio",
        "title": "HW Agents: Check Copilot Studio Integration"
      },
      {
        "command": "hwagents.syncLooka",
        "title": "HW Agents: Sync Looka Instruction"
      },
      {
        "command": "hwagents.runSkillTests",
        "title": "HW Agents: Run Skill Tests"
      },
      {
        "command": "hwagents.createSkillWizard",
        "title": "HW Agents: Create New Skill"
      },
      {
        "command": "hwagents.copyCpsManifestUrl",
        "title": "HW Agents: Copy CPS Manifest URL"
      },
      {
        "command": "hwagents.showCpsInstructions",
        "title": "HW Agents: Show CPS Setup Instructions"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ."
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.14.12"
  }
}
