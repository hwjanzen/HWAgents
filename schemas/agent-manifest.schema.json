  "type": "object",
  "required": ["agentId", "displayName", "routingConfig", "skillsManifest", "status"],
  "properties": {
    "agentId": { "type": "string" },
    "displayName": { "type": "string" },
    "manifestPath": { "type": "string" },
    "routingConfig": { "type": "string" },
    "skillsManifest": { "type": "string" },
    "status": { "enum": ["draft", "active", "deprecated", "retired"] }
  },
  "additionalProperties": false
}
