{
  "$id": "https://hwagents.local/schemas/skill-manifest-list.schema.json",
  "type": "object",
  "required": ["manifestId", "skills"],
  "properties": {
    "manifestId": { "type": "string" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "capabilities"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$" },
          "file": { "type": "string" },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
