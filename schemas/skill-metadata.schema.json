{
  "$id": "https://hwagents.local/schemas/skill-metadata.schema.json",
  "type": "object",
  "required": ["id", "name", "category", "capabilities"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$" },
    "name": { "type": "string" },
    "category": { "type": "string" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
